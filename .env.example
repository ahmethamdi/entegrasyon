APP_NAME=Entegrasyon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=entegrasyon
DB_USERNAME=entegrasyon
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Oturum çerezi sertleştirme — Mimari Karar Dokümanı v2.2 · §11.
#
# SESSION_SECURE_COOKIE: çerez düz HTTP üzerinde HİÇ gönderilmez.
#   ÜRETİMDE `true` OLMALIDIR. Yerelde `http://localhost:8080`
#   kullanıldığı için `false`; `true` yapılırsa oturum yerelde HİÇ
#   kurulamaz ve giriş sonsuz döngüye girer.
#
# SESSION_HTTP_ONLY: JavaScript çerezi okuyamaz (XSS ile oturum çalma).
# SESSION_SAME_SITE: `lax` çapraz site POST'unda çerezi göndermez (CSRF).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Europe/Istanbul

# --- Entegrasyon ---
# Docker host port eşlemeleri (yerel çakışmaları önlemek için standart dışı)
APP_PORT=8080
DB_PORT_HOST=5433
REDIS_PORT_HOST=6380

# Kuyruk ve Horizon
REDIS_QUEUE=default
HORIZON_PREFIX=entegrasyon_horizon:

# Kimlik bilgisi şifreleme anahtar sürümü (§11 · CredentialVault)
APP_KEY_VERSION=1

# Anahtar rotasyonu: eski anahtarlar virgülle ayrılır, Laravel otomatik dener.
APP_PREVIOUS_KEYS=

# Uyarı e-postaları (§11 · §12)
#
# Sistem ve kanal kapsamlı uyarıların alıcısı. TANIMSIZSA o uyarılar
# GÖNDERİLMEZ (uygulama günlüğüne `alerts.no_recipient` yazılır) — uydurma
# bir adrese göndermek yanlış kişiyi uyarmak demektir. Kiracı kapsamlı
# uyarılar bundan BAĞIMSIZDIR: onlar kiracının sahiplerine gider.
ALERT_ADMIN_EMAIL=

# Sağlayıcı `MAIL_MAILER` ile seçilir ve KOD DEĞİŞMEZ. Yerelde `log`
# yeterlidir: e-postalar storage/logs altına düşer ve akış uçtan uca
# sınanabilir. Üretimde smtp/mailgun/postmark/ses.

# ─────────────────────────────────────────────────────── ödeme (Stripe)
#
# §13 · Faz 4. KULLANICI KARARI: sağlayıcı Stripe'tır (doküman "iyzico"
# der; sapma onaylıdır ve ticari bir karardır, mimari değil).
#
# ANAHTARLAR KODA GÖMÜLMEZ. Test modu anahtarları `pk_test_` / `sk_test_`
# ile başlar; canlıya geçerken `pk_live_` / `sk_live_` ile değiştirilir ve
# KOD DEĞİŞMEZ — `MAIL_MAILER` ile aynı ilke.
STRIPE_KEY=
STRIPE_SECRET=

# İMZA SIRRI GİZLİ ANAHTARLA AYNI DEĞİLDİR ve ayrı üretilir
# (Stripe panelinde webhook uç noktası tanımlanınca verilir, `whsec_` ile
# başlar). Karıştırılırsa imza doğrulaması HER İSTEKTE başarısız olur ve
# hiçbir ödeme işlenmez — üstelik hata "geçersiz imza" der ve sebebi
# yanlış yerde aranır.
STRIPE_WEBHOOK_SECRET=
