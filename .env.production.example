# ─────────────────────────────────────────────────────────────────────
# Entegrasyon — ÜRETİM ortam dosyası örneği
#
# Kopyala:  cp .env.production.example .env.production
# Doldur, sonra:  chmod 600 .env.production
# .env.production depoya GİRMEZ (.gitignore). Kurulum: docs/URETIM-KURULUM.md
# ─────────────────────────────────────────────────────────────────────

# Alan adı — A kaydı sunucuya bakmalı; Caddy TLS sertifikasını kendisi alır.
APP_DOMAIN=panel.ornek.com
ACME_EMAIL=altyapi@ornek.com

APP_NAME=34Pazar
APP_ENV=production
APP_DEBUG=false
APP_URL=https://panel.ornek.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

# `php artisan key:generate --show` ile üret. ⚠️ İKİ AYRI YERDE YEDEKLE:
# kaybolursa kasadaki tüm kanal anahtarları ÇÖZÜLEMEZ (güvenlik listesi md. 1).
APP_KEY=
APP_KEY_VERSION=1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Veritabanı — konteyner içi; port dışarı açılmaz.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=entegrasyon
DB_USERNAME=entegrasyon
# güçlü, rastgele (openssl rand -base64 32)
DB_PASSWORD=

# Redis — parola ZORUNLU; port dışarı açılmaz.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# güçlü, rastgele (openssl rand -hex 32)
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# Posta — sağlayıcı fark etmez (Postmark, Amazon SES, Mailgun): üçü de
# SMTP verir. Seçince yalnız bu blok değişir. Gönderen alan adında
# SPF + DKIM kayıtları sağlayıcının verdiği şekilde kurulmalı; yoksa
# parola sıfırlama/doğrulama postaları gereksiz klasörüne düşer.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bildirim@ornek.com
MAIL_FROM_NAME="${APP_NAME}"

# Uyarı e-postaları (metrik eşikleri) ve kuyruk paneli erişimi.
ALERT_ADMIN_EMAIL=
# virgülle: a@ornek.com,b@ornek.com
HORIZON_ADMIN_EMAILS=

# Stripe — önce TEST anahtarlarıyla (sk_test_) pilot; webhook uç noktası
# https://APP_DOMAIN/webhooks/stripe olarak Stripe panelinde tanımlanır.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Shopify uygulaması (Partner/Dev Dashboard → uygulama → Ayarlar → Kimlik bilgileri).
# Uygulamada izinli yönlendirme adresi: https://APP_DOMAIN/channels/shopify/callback
# Zorunlu gizlilik webhook'ları:      https://APP_DOMAIN/webhooks/shopify/compliance
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Geliştirici araçları üretimde KAPALI (varsayılan da kapalı; açıkça yazılır).
INERTIA_DEVTOOLS_ENABLED=false
