                        "format": "double",
                        "nullable": true
                    },
                    "stock": {
                        "type": "integer",
                        "description": "Teklif edilen stok. Zorunlu de\u011fildir.",
                        "format": "int32",
                        "nullable": true
                    },
                    "currencyCode": {
                        "type": "string",
                        "description": "Teklif edilen fiyat\u0131n para birimi. Fiyat girildiyse zorunludur. Alabilece\u011fi de\u011ferler (TRY,USD,EUR)",
                        "nullable": true
                    },
                    "salable": {
                        "type": "boolean",
                        "description": "\u00dcr\u00fcn i\u00e7in teklif edece\u011finiz sat\u0131\u015f durumu bilgisidir. Zorunlu de\u011fildir.",
                        "nullable": true
                    },
                    "unitPerPackage": {
                        "type": "integer",
                        "description": "\u00dcr\u00fcne ait koli i\u00e7i adet bilgisidir.",
                        "format": "int32",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
